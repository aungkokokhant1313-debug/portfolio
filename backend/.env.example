# Flask Environment Configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-string-in-render

# Allowed Frontend Origins (Comma-separated)
# Include local development URLs and your final Netlify production domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-site-name.netlify.app

# Message Storage / Delivery Mode
# Options:
# - 'sqlite': Stores incoming messages in a lightweight SQLite database (messages.db)
# - 'none': Responds with instructions to use mailto fallback
# - 'smtp': For forwarding messages to your inbox (requires SMTP credentials below)
MESSAGE_STORAGE_MODE=sqlite

# Optional SMTP Settings (Only needed if MESSAGE_STORAGE_MODE=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# RECIPIENT_EMAIL=your-email@gmail.com

