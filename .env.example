# Base URL for the Python Flask Backend API
# For local testing when running "python backend/app.py" on port 5000:
# VITE_API_BASE_URL=http://127.0.0.1:5000

# For production on Netlify once deployed to Render:
# VITE_API_BASE_URL=https://your-flask-service.onrender.com

# If left blank, the portfolio operates in 100% frontend-only mode with the mailto draft workflow!
VITE_API_BASE_URL=

